{
  "policy": "discard",
  "endpoint_list": [
    {
      "name": "pixhawk_serial",
      "type": "SerialByteTransport",
      "config": {
        "device_path": "/dev/ttyUSB0",
        "baud_rate": "115200"
      },
      "connect_on_create": true
    }
  ],
  "agent_list": [
    {
      "name": "gz_bridge_iris",
      "type": "gz_agent",
      "config": {
        "vehicle_name": "iris",
        "world_name": "default",
        "mavlink_endpoint_name": "pixhawk_serial",
        "use_topic_generator": "true",
        "send_freq": "250"
      }
    }
  ]
}
